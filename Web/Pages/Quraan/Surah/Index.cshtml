@page "{id}"
@using SoundChunksWeb.Pages.Quraan.Surah
@model IndexModel
@{
    Layout = "_QuraanLayout";
    ViewData["Title"] = Model.SurahName;
}

<div class="surah-detail-container">
    <div class="surah-header">
        <h1 class="surah-title">@Model.SurahName</h1>
        @if (!string.IsNullOrEmpty(Model.Sheikh))
        {
            <div class="sheikh-info">
                <img src="@Model.SheikhImage" alt="@Model.Sheikh" class="sheikh-avatar" />
                <div class="sheikh-details">
                    <h2 class="sheikh-name">@Model.Sheikh</h2>
                    <p class="sheikh-label">القارئ المختار</p>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.AudioFilePath))
            {
                <div class="audio-player">
                    <audio controls preload="auto">
                        <source src="@Model.AudioFilePath" type="audio/mpeg">
                        متصفحك لا يدعم تشغيل الصوت.
                    </audio>
                </div>
            }
            else
            {
                <div class="no-audio-warning">
                    <p>⚠️ لم يُضف الملف الصوتي لهذه السورة بعد</p>
                </div>
            }
        }
        else
        {
            <div class="no-sheikh-info">
                <p>عرض السورة بدون صوت شيخ</p>
            </div>
        }
    </div>

    <div class="surah-content">
        <p>محتوى السورة سيظهر هنا...</p>
        <!-- Add actual surah content here -->
    </div>
</div>

<style>
    .surah-detail-container {
        padding: 30px;
    }

    .surah-header {
        text-align: center;
        margin-bottom: 40px;
        padding: 30px;
        background: linear-gradient(135deg, rgba(26, 71, 42, 0.1) 0%, rgba(45, 90, 61, 0.1) 100%);
        border-radius: 20px;
        border: 2px solid rgba(227, 194, 122, 0.2);
    }

    .surah-title {
        color: #e3c27a;
        font-size: 2.5rem;
        margin-bottom: 30px;
        font-weight: bold;
    }

    .sheikh-info {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 20px;
        margin-top: 20px;
    }

    .sheikh-avatar {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        border: 4px solid #e3c27a;
        object-fit: cover;
    }

    .sheikh-details {
        text-align: right;
    }

    .sheikh-name {
        color: #f7f5e9;
        font-size: 1.5rem;
        margin: 0 0 5px 0;
    }

    .sheikh-label {
        color: #b1c9bd;
        font-size: 0.9rem;
        margin: 0;
    }

    .no-sheikh-info {
        color: #b1c9bd;
        font-size: 1.2rem;
        margin-top: 20px;
    }

    .surah-content {
        background: rgba(255, 255, 255, 0.05);
        padding: 30px;
        border-radius: 15px;
        border: 1px solid rgba(227, 194, 122, 0.1);
    }

    .audio-player {
        margin-top: 20px;
        width: 100%;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
    }

    .audio-player audio {
        width: 100%;
        border-radius: 10px;
    }

    .no-audio-warning {
        margin-top: 20px;
        padding: 15px;
        background: rgba(255, 165, 0, 0.1);
        border: 1px solid rgba(255, 165, 0, 0.3);
        border-radius: 10px;
        color: #ffd700;
        text-align: center;
    }
</style>
