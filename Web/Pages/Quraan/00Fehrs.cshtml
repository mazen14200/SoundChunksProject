@page
@{
    Layout = "_QuraanLayout";
    ViewData["Title"] = "فهرس القرءآن الكريم";
    ViewData["ShowSidebar"] = true;
}


<div class="ac-app" id="app">

    <head>
        <link src="~/css/Fhrs.css" rel="stylesheet" />
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="theme-color" content="#0b3028">
        <title>سور القرآن الكريم | Quran Surahs</title>
        <style>
                    :root {
                        --bg: #071d19;
                        --panel: #0d3028;
                        --panel2: #124237;
                        --gold: #e3c27a;
                        --mint: #a8d9bd;
                        --text: #f7f5e9;
                        --muted: #b1c9bd;
                        --line: #ffffff18;
                    }

                    * {
                        box-sizing: border-box
                    }

                    html {
                        scroll-behavior: smooth
                    }

                    body {
                        margin: 0;
                        min-height: 100vh;
                        color: var(--text);
                        font-family: "Segoe UI",Tahoma,Arial,sans-serif;
                        background: radial-gradient(ellipse at 50% -15%,#1c6850 0,transparent 46%), radial-gradient(circle at 0% 45%,#b98b3a0d,transparent 30%), var(--bg);
                    }

                    .page-shell {
                        max-width: 1450px;
                        margin: auto;
                        padding: 0 28px
                    }

                    .hero {
                        text-align: center;
                        padding: 64px 16px 34px;
                        position: relative
                    }

                    .ornament {
                        color: var(--gold);
                        font-size: 24px;
                        letter-spacing: 12px;
                        margin-bottom: 15px
                    }

                    h1 {
                        font-family: Georgia,"Times New Roman",serif;
                        font-size: clamp(2rem,5vw,3.7rem);
                        font-weight: 600;
                        line-height: 1.25;
                        margin: 0;
                        color: #fff9e9
                    }

                        h1 span {
                            color: var(--gold)
                        }

                    .intro {
                        color: var(--muted);
                        font-size: 1rem;
                        line-height: 1.9;
                        margin: 14px auto 0;
                        max-width: 620px
                    }

                    .stats {
                        display: flex;
                        justify-content: center;
                        gap: 10px;
                        flex-wrap: wrap;
                        margin-top: 24px
                    }

                    .stat {
                        border: 1px solid #e3c27a42;
                        background: #ffffff08;
                        border-radius: 999px;
                        padding: 8px 16px;
                        color: #e8dfc7;
                        font-size: .88rem
                    }

                        .stat strong {
                            color: var(--gold);
                            margin-left: 5px
                        }

                    .toolbar {
                        max-width: 780px;
                        margin: 0 auto 30px;
                        display: flex;
                        gap: 12px;
                        align-items: center
                    }

                    .search-wrap {
                        position: relative;
                        flex: 1
                    }

                    .search-icon {
                        position: absolute;
                        right: 17px;
                        top: 50%;
                        transform: translateY(-50%);
                        color: var(--gold);
                        font-size: 19px;
                        pointer-events: none
                    }

                    #search {
                        width: 100%;
                        padding: 16px 48px 16px 16px;
                        border: 1px solid #ffffff22;
                        border-radius: 16px;
                        background: #ffffff0c;
                        color: white;
                        font: inherit;
                        outline: none;
                        transition: .2s
                    }

                        #search::placeholder {
                            color: #a6bdb1
                        }

                        #search:focus {
                            border-color: var(--gold);
                            box-shadow: 0 0 0 4px #e3c27a18;
                            background: #ffffff10
                        }

                        #search::-webkit-search-cancel-button {
                            cursor: pointer
                        }

                    .result-count {
                        text-align: center;
                        color: var(--muted);
                        font-size: .88rem;
                        margin: -14px 0 23px
                    }

                    .grid {
                        display: grid;
                        grid-template-columns: repeat(6,minmax(0,1fr));
                        gap: 17px;
                        padding-bottom: 54px
                    }

                    .surah-card {
                        position: relative;
                        isolation: isolate;
                        overflow: hidden;
                        min-height: 196px;
                        padding: 18px 14px 17px;
                        display: flex;
                        flex-direction: column;
                        align-items: center;
                        justify-content: center;
                        gap: 9px;
                        text-decoration: none;
                        color: var(--text);
                        border: 1px solid #d7c18b30;
                        border-radius: 20px;
                        background: linear-gradient(145deg,#16483aee,#0c2c25f5 76%);
                        box-shadow: 0 9px 24px #0000001c,inset 0 1px 0 #ffffff0a;
                        transition: transform .22s ease,border-color .22s ease,background .22s ease,box-shadow .22s ease;
                        cursor: pointer;
                    }

                        .surah-card::before {
                            content: "";
                            position: absolute;
                            z-index: -1;
                            width: 180px;
                            height: 180px;
                            border-radius: 50%;
                            top: -112px;
                            left: -95px;
                            background: #e3c27a0c;
                            transition: transform .3s,background .3s
                        }

                        .surah-card::after {
                            content: "";
                            position: absolute;
                            bottom: 0;
                            right: 18%;
                            left: 18%;
                            height: 2px;
                            background: linear-gradient(90deg,transparent,var(--gold),transparent);
                            opacity: .45;
                            transition: left .25s,right .25s,opacity .25s
                        }

                        .surah-card:hover, .surah-card:focus-visible {
                            transform: translateY(-6px);
                            border-color: #e3c27ac9;
                            background: linear-gradient(145deg,#21674e,#124334 76%);
                            box-shadow: 0 17px 35px #0000003d,0 0 0 1px #e3c27a16;
                            outline: none;
                        }

                            .surah-card:hover::before, .surah-card:focus-visible::before {
                                transform: scale(1.7);
                                background: #e3c27a18
                            }

                            .surah-card:hover::after, .surah-card:focus-visible::after {
                                left: 8%;
                                right: 8%;
                                opacity: 1
                            }

                        .surah-card:active {
                            transform: translateY(-1px) scale(.985);
                            background: #2c7658
                        }

                    .card-top {
                        width: 100%;
                        display: flex;
                        align-items: center;
                        justify-content: space-between;
                        position: absolute;
                        top: 13px;
                        right: 0;
                        padding: 0 15px
                    }

                    .surah-number {
                        font-size: .72rem;
                        font-weight: 700;
                        letter-spacing: .13em;
                        color: #d8cda9;
                        background: #ffffff0a;
                        border: 1px solid #ffffff12;
                        border-radius: 8px;
                        padding: 5px 7px;
                        direction: ltr
                    }

                    .card-mark {
                        font-size: 23px;
                        color: var(--gold);
                        opacity: .85;
                        line-height: 1
                    }

                    .surah-arabic {
                        font-family: "Traditional Arabic","Noto Naskh Arabic",Tahoma,serif;
                        font-size: clamp(1.3rem,1.65vw,1.7rem);
                        font-weight: 700;
                        color: #fff7e2;
                        margin-top: 19px;
                        text-align: center;
                        line-height: 1.5
                    }

                    .surah-english {
                        font-size: .83rem;
                        letter-spacing: .035em;
                        color: #b8d1c2;
                        text-align: center
                    }

                    .verse-count {
                        display: inline-flex;
                        align-items: center;
                        gap: 6px;
                        margin-top: 5px;
                        padding: 6px 12px;
                        border: 1px solid #e3c27a2e;
                        border-radius: 999px;
                        background: #e3c27a0b;
                        color: #f0dba6;
                        font-size: .78rem;
                        white-space: nowrap
                    }

                    .verse-icon {
                        font-size: .75rem;
                        color: var(--gold)
                    }

                    .empty {
                        grid-column: 1/-1;
                        text-align: center;
                        padding: 50px 15px;
                        border: 1px dashed #ffffff2a;
                        border-radius: 18px;
                        color: var(--muted)
                    }

                    footer {
                        border-top: 1px solid var(--line);
                        text-align: center;
                        padding: 23px 10px 30px;
                        color: #91ada0;
                        font-size: 1.40rem;
                        line-height: 1.8
                    }

                        footer span {
                            color: var(--gold)
                        }

                        footer .footer-button-wrapper {
                            margin-top: 12px;
                        }

                        footer a {
                            color: var(--gold);
                            text-decoration: none;
                            transition: opacity 0.2s;
                            display: inline-block;
                        }

                        footer a:hover {
                            opacity: 0.8;
                        }

                        .footer-link {
                            font-size: 0.75rem;
                            padding: 6px 12px;
                            border: 1px solid #e3c27a42;
                            background: #ffffff08;
                            border-radius: 8px;
                            color: #e8dfc7;
                            text-decoration: none;
                            display: inline-block;
                        }

                    [hidden] {
                        display: none !important
                    }

                    @@media (max-width: 1400px) {
                        .grid {
                            grid-template-columns: repeat(5, minmax(0, 1fr));
                        }
                    }

                    @@media (max-width: 1200px) {
                        .grid {
                            grid-template-columns: repeat(4, minmax(0, 1fr));
                        }
                    }

                    @@media (max-width: 900px) {
                        .grid {
                            grid-template-columns: repeat(3, minmax(0, 1fr));
                        }

                        .toolbar {
                            max-width: 100%;
                        }
                    }

                    @@media (max-width: 760px) {
                        .page-shell {
                            padding: 0 16px
                        }

                        .hero {
                            padding-top: 45px;
                            padding-bottom: 20px;
                        }

                        .ornament {
                            font-size: 20px;
                            letter-spacing: 8px;
                        }

                        h1 {
                            font-size: clamp(1.8rem, 4vw, 2.8rem);
                        }

                        .intro {
                            font-size: 0.95rem;
                            max-width: 100%;
                        }

                        .stats {
                            gap: 8px;
                        }

                        .stat {
                            padding: 6px 12px;
                            font-size: 0.82rem;
                        }

                        .toolbar {
                            margin: 0 auto 20px;
                            flex-direction: column;
                        }

                        #search {
                            padding: 14px 40px 14px 14px;
                            font-size: 0.95rem;
                        }

                        .grid {
                            grid-template-columns: repeat(3, minmax(0, 1fr));
                            gap: 12px
                        }

                        .surah-card {
                            min-height: 175px;
                            border-radius: 17px;
                            padding: 15px 10px 14px;
                        }

                        .surah-arabic {
                            font-size: 1.35rem
                        }

                        .surah-english {
                            font-size: .74rem
                        }

                        .verse-count {
                            font-size: 0.72rem;
                            padding: 5px 10px;
                        }
                    }

                    @@media (max-width: 600px) {
                        .grid {
                            grid-template-columns: repeat(2, minmax(0, 1fr));
                            gap: 10px;
                        }

                        .surah-card {
                            min-height: 160px;
                            padding: 12px 8px 12px;
                        }

                        .surah-number {
                            font-size: 0.65rem;
                            padding: 4px 6px;
                        }

                        .card-mark {
                            font-size: 20px;
                        }

                        .surah-arabic {
                            font-size: 1.25rem;
                        }

                        .surah-english {
                            font-size: 0.7rem;
                        }
                    }

                    @@media (max-width: 480px) {
                        .page-shell {
                            padding: 0 12px;
                        }

                        .hero {
                            padding: 35px 10px 20px;
                        }

                        .ornament {
                            font-size: 18px;
                            letter-spacing: 6px;
                            margin-bottom: 12px;
                        }

                        h1 {
                            font-size: clamp(1.5rem, 5vw, 2.2rem);
                        }

                        .intro {
                            font-size: 0.88rem;
                            line-height: 1.7;
                        }

                        .stats {
                            margin-top: 18px;
                        }

                        .stat {
                            padding: 5px 10px;
                            font-size: 0.78rem;
                        }

                        .toolbar {
                            margin-bottom: 20px;
                        }

                        #search {
                            padding: 12px 36px 12px 12px;
                            font-size: 0.9rem;
                            border-radius: 12px;
                        }

                        .search-icon {
                            right: 14px;
                            font-size: 17px;
                        }

                        .grid {
                            grid-template-columns: repeat(2, minmax(0, 1fr));
                            gap: 8px;
                        }

                        .surah-card {
                            min-height: 150px;
                            border-radius: 14px;
                            padding: 10px 6px 10px;
                        }

                        .surah-number {
                            font-size: 0.6rem;
                            padding: 3px 5px;
                        }

                        .card-mark {
                            font-size: 18px;
                        }

                        .surah-arabic {
                            font-size: 1.15rem;
                            margin-top: 15px;
                        }

                        .surah-english {
                            font-size: 0.65rem;
                        }

                        .verse-count {
                            font-size: 0.68rem;
                            padding: 4px 8px;
                            margin-top: 4px;
                        }

                        footer {
                            font-size: 0.75rem;
                            padding: 18px 8px 24px;
                        }

                        .footer-link {
                            font-size: 0.7rem;
                            padding: 5px 10px;
                        }
                    }

                    @@media (max-width: 360px) {
                        .grid {
                            grid-template-columns: repeat(2, minmax(0, 1fr));
                            gap: 6px;
                        }

                        .surah-card {
                            min-height: 140px;
                            padding: 8px 4px 8px;
                        }

                        .surah-arabic {
                            font-size: 1rem;
                        }

                        .surah-english {
                            font-size: 0.6rem;
                        }

                        .verse-count {
                            font-size: 0.62rem;
                            padding: 3px 6px;
                        }
                    }
                    @@media (prefers-reduced-motion: reduce) {
                        *, *::before, *::after {
                            scroll-behavior: auto !important;
                            transition: none !important
                        }
                    }
        </style>
    </head>
    <body>
        <header class="hero page-shell">
            <div class="ornament" aria-hidden="true">۞ ✧ ۞</div>
            <h1>سُوَرُ <span>القرآن الكريم</span></h1>
            <p class="intro">تصفّح سور القرآن الكريم في بطاقات أنيقة، مع اسم كل سورة ورقمها وعدد آياتها.</p>
            <div class="stats">
                <div class="stat"><strong>١١٤</strong> سورة</div>
                <div class="stat"><strong>٦٢٣٦</strong> آية </div>
                <div class="stat">تصميم متجاوب وأنيق</div>
            </div>
        </header>
        <main class="page-shell">
            <div class="toolbar">
                <div class="search-wrap">
                    <span class="search-icon" aria-hidden="true">⌕</span>
                    <input id="search" type="search" placeholder="ابحث عن سورة بالاسم أو الرقم..." aria-label="ابحث عن سورة">
                </div>
            </div>
            <p class="result-count" id="result-count" aria-live="polite">جميع السور الـ ١١٤</p>
            <section class="grid" id="surah-grid" aria-label="بطاقات سور القرآن الكريم">
                <a class="surah-card" id="1-Al-Fatihah" href="#1-Al-Fatihah" data-number="1" data-arabic="الفاتحة" data-english="al-fatihah" data-verses="7" aria-label="سورة الفاتحة، 7 آيات">
                    <span class="card-top"><span class="surah-number">001</span><span class="card-mark" aria-hidden="true">۞</span></span>
                    <span class="surah-arabic" lang="ar">الفاتحة</span>
                    <span class="surah-english" dir="ltr">Al-Fatihah</span>
                    <span class="verse-count"><span class="verse-icon" aria-hidden="true">✦</span> 7 آية</span>
                </a>
                <a class="surah-card" id="2-Al-Baqarah" href="#2-Al-Baqarah" data-number="2" data-arabic="البقرة" data-english="al-baqarah" data-verses="286" aria-label="سورة البقرة، 286 آيات">
                    <span class="card-top"><span class="surah-number">002</span><span class="card-mark" aria-hidden="true">۞</span></span>
                    <span class="surah-arabic" lang="ar">البقرة</span>
                    <span class="surah-english" dir="ltr">Al-Baqarah</span>
                    <span class="verse-count"><span class="verse-icon" aria-hidden="true">✦</span> 286 آية</span>
                </a>
                <a class="surah-card" id="3-Ali-Imran" href="#3-Ali-Imran" data-number="3" data-arabic="آل عمران" data-english="ali-imran" data-verses="200" aria-label="سورة آل عمران، 200 آيات">
                    <span class="card-top"><span class="surah-number">003</span><span class="card-mark" aria-hidden="true">۞</span></span>
                    <span class="surah-arabic" lang="ar">آل عمران</span>
                    <span class="surah-english" dir="ltr">Ali-Imran</span>
                    <span class="verse-count"><span class="verse-icon" aria-hidden="true">✦</span> 200 آية</span>
                </a>
                <a class="surah-card" id="4-An-Nisa" href="#4-An-Nisa" data-number="4" data-arabic="النساء" data-english="an-nisa" data-verses="176" aria-label="سورة النساء، 176 آيات">
                    <span class="card-top"><span class="surah-number">004</span><span class="card-mark" aria-hidden="true">۞</span></span>
                    <span class="surah-arabic" lang="ar">النساء</span>
                    <span class="surah-english" dir="ltr">An-Nisa</span>
                    <span class="verse-count"><span class="verse-icon" aria-hidden="true">✦</span> 176 آية</span>
                </a>
                <a class="surah-card" id="5-Al-Maidah" href="#5-Al-Maidah" data-number="5" data-arabic="المائدة" data-english="al-maidah" data-verses="120" aria-label="سورة المائدة، 120 آيات">
                    <span class="card-top"><span class="surah-number">005</span><span class="card-mark" aria-hidden="true">۞</span></span>
                    <span class="surah-arabic" lang="ar">المائدة</span>
                    <span class="surah-english" dir="ltr">Al-Maidah</span>
                    <span class="verse-count"><span class="verse-icon" aria-hidden="true">✦</span> 120 آية</span>
                </a>
                <a class="surah-card" id="6-Al-Anam" href="#6-Al-Anam" data-number="6" data-arabic="الأنعام" data-english="al-anam" data-verses="165" aria-label="سورة الأنعام، 165 آيات">
                    <span class="card-top"><span class="surah-number">006</span><span class="card-mark" aria-hidden="true">۞</span></span>
                    <span class="surah-arabic" lang="ar">الأنعام</span>
                    <span class="surah-english" dir="ltr">Al-Anam</span>
                    <span class="verse-count"><span class="verse-icon" aria-hidden="true">✦</span> 165 آية</span>
                </a>
                <a class="surah-card" id="7-Al-Araf" href="#7-Al-Araf" data-number="7" data-arabic="الأعراف" data-english="al-araf" data-verses="206" aria-label="سورة الأعراف، 206 آيات">
                    <span class="card-top"><span class="surah-number">007</span><span class="card-mark" aria-hidden="true">۞</span></span>
                    <span class="surah-arabic" lang="ar">الأعراف</span>
                    <span class="surah-english" dir="ltr">Al-Araf</span>
                    <span class="verse-count"><span class="verse-icon" aria-hidden="true">✦</span> 206 آية</span>
                </a>
                <a class="surah-card" id="8-Al-Anfal" href="#8-Al-Anfal" data-number="8" data-arabic="الأنفال" data-english="al-anfal" data-verses="75" aria-label="سورة الأنفال، 75 آيات">
                    <span class="card-top"><span class="surah-number">008</span><span class="card-mark" aria-hidden="true">۞</span></span>
                    <span class="surah-arabic" lang="ar">الأنفال</span>
                    <span class="surah-english" dir="ltr">Al-Anfal</span>
                    <span class="verse-count"><span class="verse-icon" aria-hidden="true">✦</span> 75 آية</span>
                </a>
                <a class="surah-card" id="9-At-Tawbah" href="#9-At-Tawbah" data-number="9" data-arabic="التوبة" data-english="at-tawbah" data-verses="129" aria-label="سورة التوبة، 129 آيات">
                    <span class="card-top"><span class="surah-number">009</span><span class="card-mark" aria-hidden="true">۞</span></span>
                    <span class="surah-arabic" lang="ar">التوبة</span>
                    <span class="surah-english" dir="ltr">At-Tawbah</span>
                    <span class="verse-count"><span class="verse-icon" aria-hidden="true">✦</span> 129 آية</span>
                </a>
                <a class="surah-card" id="10-Yunus" href="#10-Yunus" data-number="10" data-arabic="يونس" data-english="yunus" data-verses="109" aria-label="سورة يونس، 109 آيات">
                    <span class="card-top"><span class="surah-number">010</span><span class="card-mark" aria-hidden="true">۞</span></span>
                    <span class="surah-arabic" lang="ar">يونس</span>
                    <span class="surah-english" dir="ltr">Yunus</span>
                    <span class="verse-count"><span class="verse-icon" aria-hidden="true">✦</span> 109 آية</span>
                </a>
                <a class="surah-card" id="11-Hud" href="#11-Hud" data-number="11" data-arabic="هود" data-english="hud" data-verses="123" aria-label="سورة هود، 123 آيات">
                    <span class="card-top"><span class="surah-number">011</span><span class="card-mark" aria-hidden="true">۞</span></span>
                    <span class="surah-arabic" lang="ar">هود</span>
                    <span class="surah-english" dir="ltr">Hud</span>
                    <span class="verse-count"><span class="verse-icon" aria-hidden="true">✦</span> 123 آية</span>
                </a>
                <a class="surah-card" id="12-Yusuf" href="#12-Yusuf" data-number="12" data-arabic="يوسف" data-english="yusuf" data-verses="111" aria-label="سورة يوسف، 111 آيات">
                    <span class="card-top"><span class="surah-number">012</span><span class="card-mark" aria-hidden="true">۞</span></span>
                    <span class="surah-arabic" lang="ar">يوسف</span>
                    <span class="surah-english" dir="ltr">Yusuf</span>
                    <span class="verse-count"><span class="verse-icon" aria-hidden="true">✦</span> 111 آية</span>
                </a>
                <a class="surah-card" id="13-Ar-Rad" href="#13-Ar-Rad" data-number="13" data-arabic="الرعد" data-english="ar-rad" data-verses="43" aria-label="سورة الرعد، 43 آيات">
                    <span class="card-top"><span class="surah-number">013</span><span class="card-mark" aria-hidden="true">۞</span></span>
                    <span class="surah-arabic" lang="ar">الرعد</span>
                    <span class="surah-english" dir="ltr">Ar-Rad</span>
