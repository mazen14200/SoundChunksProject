@page
@model IndexModel
@{
    ViewData["Title"] = "Audio Chunks";
}

<div class="container">
    <div class="row">
        <div class="col-12">
            <h1 class="mb-4">Audio Chunks</h1>
            
            <!-- File Upload Section -->
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">Select Audio File</h5>
                    <div class="mb-3">
                        <input type="file" id="audioFileInput" accept="audio/*" class="form-control">
                    </div>
                    <div id="fileInfo" class="text-muted" style="display: none;">
                        <p><strong>File:</strong> <span id="fileName"></span></p>
                        <p><strong>Project:</strong> <span id="projectName"></span></p>
                    </div>
                </div>
            </div>

            <!-- Audio Player Section -->
            <div class="card mb-4" id="playerCard" style="display: none;">
                <div class="card-body">
                    <h5 class="card-title">Audio Player</h5>
                    
                    <!-- Waveform Container -->
                    <div class="mb-3">
                        <canvas id="waveformCanvas" style="width: 100%; height: 150px; background: #f0f0f0; border-radius: 4px;"></canvas>
                    </div>

                    <!-- Audio Element -->
                    <audio id="audioPlayer" style="width: 100%;"></audio>

                    <!-- Time Display -->
                    <div class="row mb-3">
                        <div class="col-6">
                            <span class="text-muted">Current: <span id="currentTime">0.00</span>s</span>
                        </div>
                        <div class="col-6 text-end">
                            <span class="text-muted">Duration: <span id="duration">0.00</span>s</span>
                        </div>
                    </div>

                    <!-- Player Controls -->
                    <div class="btn-group mb-3" role="group">
                        <button type="button" id="playBtn" class="btn btn-primary">Play</button>
                        <button type="button" id="pauseBtn" class="btn btn-secondary">Pause</button>
                        <button type="button" id="resumeBtn" class="btn btn-secondary">Resume</button>
                        <button type="button" id="stopBtn" class="btn btn-secondary">Stop</button>
                        <button type="button" id="cutBtn" class="btn btn-danger">CUT</button>
                    </div>

                    <!-- Project Info -->
                    <div class="row">
                        <div class="col-md-6">
                            <p class="mb-1"><strong>Next Chunk:</strong> <span id="nextChunkNumber">1</span></p>
                            <p class="mb-1"><strong>Previous Cut Position:</strong> <span id="lastCutPosition">0.00</span>s</p>
                        </div>
                        <div class="col-md-6">
                            <p class="mb-1"><strong>Current Position:</strong> <span id="currentPositionDisplay">0.00</span>s</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Status Messages -->
            <div id="statusMessage" class="alert" style="display: none;"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/wavesurfer.js@7/dist/wavesurfer.min.js"></script>
    <script>
        let wavesurfer;
        let audioPlayer;
        let currentProject = null;
        let sourceFilePath = null;

        document.addEventListener('DOMContentLoaded', function() {
            audioPlayer = document.getElementById('audioPlayer');
            
            // Initialize WaveSurfer
            wavesurfer = WaveSurfer.create({
                container: '#waveformCanvas',
                waveColor: '#4a90e2',
                progressColor: '#2c5282',
                cursorColor: '#e53e3e',
                barWidth: 2,
                barRadius: 3,
                cursorWidth: 1,
                height: 150,
                barGap: 3
            });

            // File upload handler
            document.getElementById('audioFileInput').addEventListener('change', handleFileUpload);

            // Player controls
            document.getElementById('playBtn').addEventListener('click', playAudio);
            document.getElementById('pauseBtn').addEventListener('click', pauseAudio);
            document.getElementById('resumeBtn').addEventListener('click', resumeAudio);
            document.getElementById('stopBtn').addEventListener('click', stopAudio);
            document.getElementById('cutBtn').addEventListener('click', cutAudio);

            // Sync WaveSurfer with audio player
            audioPlayer.addEventListener('timeupdate', updateCurrentTime);
            audioPlayer.addEventListener('loadedmetadata', updateDuration);
            audioPlayer.addEventListener('ended', onAudioEnded);

            // WaveSurfer click to seek
            wavesurfer.on('click', function(position) {
                audioPlayer.currentTime = position * audioPlayer.duration;
            });
        });

        async function handleFileUpload(event) {
            const file = event.target.files[0];
            if (!file) return;

            showStatus('info', 'Uploading file...');

            const formData = new FormData();
            formData.append('file', file);

            try {
                const response = await fetch('/api/audio/upload', {
                    method: 'POST',
                    body: formData
                });

                if (!response.ok) {
                    const errorText = await response.text();
                    try {
                        const error = JSON.parse(errorText);
                        throw new Error(error.error || 'Upload failed');
                    } catch {
                        throw new Error(errorText || 'Upload failed');
                    }
                }

                const data = await response.json();
                sourceFilePath = data.filePath;
                currentProject = data.project;

                // Update UI
                document.getElementById('fileName').textContent = file.name;
                document.getElementById('projectName').textContent = currentProject.projectName;
                document.getElementById('fileInfo').style.display = 'block';
                document.getElementById('playerCard').style.display = 'block';

                // Load audio
                audioPlayer.src = sourceFilePath;
                wavesurfer.load(sourceFilePath);

                // Update project info
                updateProjectInfo();

                showStatus('success', 'File loaded successfully!');
            } catch (error) {
                showStatus('danger', error.message);
            }
        }

        function playAudio() {
            audioPlayer.play();
            wavesurfer.play();
        }

        function pauseAudio() {
            audioPlayer.pause();
            wavesurfer.pause();
        }

        function resumeAudio() {
            audioPlayer.play();
            wavesurfer.play();
        }

        function stopAudio() {
            audioPlayer.pause();
            audioPlayer.currentTime = 0;
            wavesurfer.stop();
        }

        async function cutAudio() {
            if (!currentProject || !sourceFilePath) {
                showStatus('danger', 'No audio file loaded');
                return;
            }

            const currentPosition = audioPlayer.currentTime;
            const cutBtn = document.getElementById('cutBtn');
            
            // Disable button during operation
            cutBtn.disabled = true;
            cutBtn.textContent = 'Cutting...';

            try {
                const response = await fetch('/api/audio/cut', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        projectName: currentProject.projectName,
                        sourceFilePath: sourceFilePath,
                        currentPosition: currentPosition
                    })
                });

                if (!response.ok) {
                    const errorText = await response.text();
                    try {
                        const error = JSON.parse(errorText);
                        throw new Error(error.error || 'Cut failed');
                    } catch {
                        throw new Error(errorText || 'Cut failed');
                    }
                }

                const data = await response.json();
                
                // Update project info
                currentProject.lastCutPosition = data.lastCutPosition;
                updateProjectInfo();

                showStatus('success', `Chunk ${data.chunkNumber} created successfully!`);
            } catch (error) {
                showStatus('danger', error.message);
            } finally {
                cutBtn.disabled = false;
                cutBtn.textContent = 'CUT';
            }
        }

        function updateCurrentTime() {
            const currentTime = audioPlayer.currentTime;
            document.getElementById('currentTime').textContent = currentTime.toFixed(2);
            document.getElementById('currentPositionDisplay').textContent = currentTime.toFixed(2);
            
            // Update WaveSurfer progress
            if (audioPlayer.duration > 0) {
                wavesurfer.seekTo(currentTime / audioPlayer.duration);
            }
        }

        function updateDuration() {
            const duration = audioPlayer.duration;
            document.getElementById('duration').textContent = duration.toFixed(2);
            
            // Update project duration
            if (currentProject) {
                currentProject.duration = duration;
            }
        }

        function onAudioEnded() {
            wavesurfer.stop();
        }

        function updateProjectInfo() {
            if (!currentProject) return;
            
            document.getElementById('nextChunkNumber').textContent = currentProject.nextChunkNumber;
            document.getElementById('lastCutPosition').textContent = currentProject.lastCutPosition.toFixed(2);
        }

        function showStatus(type, message) {
            const statusDiv = document.getElementById('statusMessage');
            statusDiv.className = `alert alert-${type}`;
            statusDiv.textContent = message;
            statusDiv.style.display = 'block';

            // Auto-hide success messages after 3 seconds
            if (type === 'success') {
                setTimeout(() => {
                    statusDiv.style.display = 'none';
                }, 3000);
            }
        }
    </script>
}
