@page
@{
    ViewData["Title"] = "Sound Chunks";
}

<link rel="stylesheet" href="~/css/audio-studio.css" />

<div class="ac-app" id="app">

    <header class="ac-top">
        <div class="ac-file">
            <input type="file" id="fileInput" class="ac-file-input"
                   accept="audio/*,.mp3,.wav,.m4a,.flac,.ogg,.aac,.wma,.opus" />
            <label for="fileInput" class="ac-btn ac-btn-quiet" id="pickBtn">Choose audio file</label>
            <div class="ac-file-meta">
                <span class="ac-file-name" id="fileName">No file selected</span>
                <span class="ac-file-sub" id="fileSub">Choose a file to start cutting.</span>
            </div>
        </div>
        <progress class="ac-progress" id="uploadProgress" max="1" value="0" hidden></progress>
    </header>

    <section class="ac-readout" aria-label="Playback position">
        <div class="ac-clock">
            <span class="ac-clock-now" id="curTime">00:00.00</span>
            <span class="ac-clock-total">of <span id="totalTime">00:00.00</span></span>
        </div>
        <dl class="ac-stats">
            <div><dt>Next chunk</dt><dd id="statChunk">–</dd></div>
            <div><dt>Previous cut</dt><dd id="statPrevCut">–</dd></div>
            <div><dt>This chunk</dt><dd id="statPending">–</dd></div>
        </dl>
    </section>

    <section class="ac-wave" aria-label="Waveform">
        <div class="ac-wave-frame">
            <div class="ac-viewport" id="viewport" tabindex="-1">
                <div class="ac-inner" id="inner">
                    <canvas id="wfCanvas" class="ac-canvas"></canvas>
                </div>
            </div>
            <div class="ac-overlay" id="wfOverlay">Choose an audio file to see its waveform.</div>
        </div>

        <div class="ac-seekrow">
            <input type="range" id="seek" class="ac-seek" min="0" max="1" step="0.01" value="0"
                   aria-label="Position in the audio" disabled />
        </div>
    </section>

    <section class="ac-controls" aria-label="Controls">
        <div class="ac-group">
            <button type="button" class="ac-btn" id="btnBack" title="Go back 10 seconds" disabled>&minus;10 s</button>
            <button type="button" class="ac-btn ac-btn-primary" id="btnPlay" disabled>Play</button>
            <button type="button" class="ac-btn" id="btnPause" disabled>Pause</button>
            <button type="button" class="ac-btn" id="btnResume" disabled>Resume</button>
            <button type="button" class="ac-btn" id="btnStop" disabled>Stop</button>
            <button type="button" class="ac-btn" id="btnFwd" title="Go forward 10 seconds" disabled>+10 s</button>
        </div>

        <div class="ac-group ac-zoom" role="group" aria-label="Zoom">
            <button type="button" class="ac-btn ac-btn-quiet" id="zoomOut" title="Zoom out" disabled>&minus;</button>
            <button type="button" class="ac-btn ac-btn-quiet" id="zoomFit" title="Fit the whole audio" disabled>Fit</button>
            <button type="button" class="ac-btn ac-btn-quiet" id="zoomIn" title="Zoom in" disabled>+</button>
        </div>

        <button type="button" class="ac-btn ac-btn-cut" id="btnCut" disabled>CUT</button>
    </section>

    <audio id="audio" preload="auto"></audio>
    <div class="ac-toast" id="toast" role="status" aria-live="polite"></div>
</div>

<script src="~/js/audio-studio.js"></script>
